# syntax=docker/dockerfile:1-labs
FROM python:3.12-slim AS builder

# Install and configure Poetry
RUN pip install "poetry>=2.3.1"
ENV DEBIAN_FRONTEND=noninteractive \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1 \
    POETRY_CACHE_DIR="/tmp/poetry_cache"

# Initialize workspace and install dependencies
WORKDIR /app
COPY . /app

RUN --mount=type=cache,target=$POETRY_CACHE_DIR \
    poetry install --only main

FROM python:3.12-slim AS runtime

# Copy the virtual environment only from a building stage
ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    INPUT_DIR=/app/inputs \
    OUTPUT_DIR=/app/outputs \
    MODELS_DIR=/app/models

WORKDIR /app

COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}

# Copy the source code
COPY . /app

RUN mkdir -p /app/inputs /app/outputs /app/models

ENTRYPOINT ["smoothli-dino-v2"]
CMD ["consume"]
